CLOCKIFY_API_KEY="YOUR_CLOCKIFY_API_KEY"
# Clockify rate limits aggressively. Defaults: one user at a time + ~0.35s between all API calls.
# Increase concurrency only if you still see no 429s.
# CLOCKIFY_FETCH_CONCURRENCY=1
# CLOCKIFY_MIN_REQUEST_INTERVAL_SEC=0.35
OPEN_AI_API_KEY="YOUR_OPEN_AI_API_KEY"
# Optional: gpt-4o-mini is default (cheap). Set LOGLLENS_SKIP_OPENAI=true to use local scores only (no API cost).
# OPEN_AI_MODEL=gpt-4o-mini
# LOGLLENS_SKIP_OPENAI=false
CLOCKIFY_WORKSPACE_ID="YOUR_CLOCKIFY_WORKSPACE_ID"
MIN_HOURS_PER_DAY=6
