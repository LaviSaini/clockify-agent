# Clockify: Profile → API → Generate (https://clockify.me)
CLOCKIFY_API_KEY=

# Optional: fix workspace if you have several (otherwise first workspace is used)
# CLOCKIFY_WORKSPACE_ID=

# OpenAI-compatible API (set base URL if you use Azure, OpenRouter, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
